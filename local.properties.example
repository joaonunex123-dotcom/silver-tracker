# Copie para local.properties e preencha. local.properties nao vai para o git.

# Caminho do SDK do Android (o Android Studio preenche sozinho).
sdk.dir=C\:\\Users\\SEU_USUARIO\\AppData\\Local\\Android\\Sdk

# A API de cotacao NAO exige chave. Esta linha e opcional e so serve para apontar
# o app a outro provedor, a um proxy ou a um mock em testes.
# Trocar de provedor exige adaptar tambem MetaisDto.kt, MetaisApi.kt e o
# mapeamento em CotacaoRepository.atualizar().
# cotacao.api.baseUrl=https://economia.awesomeapi.com.br/
